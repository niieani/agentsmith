{
  "name": "asmith",
  "version": "0.3.0",
  "description": "Compose agent instructions and skills into native, scope-aware artifacts for Codex and Claude Code",
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "cli",
    "instructions",
    "skills"
  ],
  "homepage": "https://niieani.github.io/agentsmith/",
  "bugs": {
    "url": "https://github.com/niieani/agentsmith/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niieani/agentsmith.git"
  },
  "author": "Bazyli Brzoska <npm@invent.life> (https://github.com/niieani)",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/npm/asmith.js"
  ],
  "bin": {
    "asmith": "dist/npm/asmith.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/asmith",
    "npm:build": "bun build src/cli.ts --target=node --packages=external --outfile dist/npm/asmith.js",
    "prepack": "bun run npm:build",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "release:build": "bun run scripts/release.ts build",
    "release:package": "bun run scripts/release.ts package",
    "homebrew:cask": "bun run scripts/render-homebrew-cask.ts",
    "docs:dev": "cd website && blume dev",
    "docs:build": "cd website && blume build --strict",
    "docs:check": "cd website && blume check --strict",
    "docs:validate": "cd website && blume validate --strict",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@optique/core": "1.1.1",
    "@optique/run": "1.1.1",
    "smol-toml": "1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "blume": "1.0.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
